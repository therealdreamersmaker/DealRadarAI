# AI Provider — set LLM_PROVIDER to 'gemini', 'groq', or 'auto' (tries Gemini first, falls back to Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=auto

# RentCast — real MLS listings (free tier: 50 req/month)
# Get your free key at https://app.rentcast.io/login
RENTCAST_API_KEY=your_rentcast_api_key_here

# GoHighLevel CRM (optional)
GHL_API_KEY=your_gohighlevel_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
BATCHDATA_API_KEY=your_batchdata_api_key_here
PORT=3001
